prometheus.scrape "traefik" {
  targets         = [{"__address__" = "traefik:8080"}]
%{ if alloy_metrics_keep_regex != "" ~}
  forward_to      = [prometheus.relabel.keep.receiver]
%{ else ~}
  forward_to      = [prometheus.remote_write.default.receiver]
%{ endif ~}
  metrics_path    = "/metrics"
  scrape_interval = "${alloy_scrape_interval}"
}

%{ if alloy_metrics_keep_regex != "" ~}
// Only the listed metrics are sent: managed backends bill per sample, and Traefik's full output
// (mostly latency histogram buckets) is ~30x more than "is there traffic" needs.
prometheus.relabel "keep" {
  forward_to = [prometheus.remote_write.default.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "${alloy_metrics_keep_regex}"
    action        = "keep"
  }
}
%{ endif ~}

prometheus.remote_write "default" {
  endpoint {
    url = "${alloy_remote_write_url}"
    basic_auth {
      username = "${alloy_remote_write_username}"
      password = "${alloy_remote_write_token}"
    }
  }
}

%{ if alloy_loki_write_url != "" ~}
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "service_name"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "${alloy_loki_write_url}"
    basic_auth {
      username = "${alloy_loki_write_username}"
      password = "${alloy_loki_write_token}"
    }
  }
}
%{ endif ~}