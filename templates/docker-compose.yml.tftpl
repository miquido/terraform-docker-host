networks:
  traefik-net:
    name: traefik-net

services:
  traefik:
    image: traefik:v3.7.13
%{ if length(traefik_entrypoint) > 0 ~}
    entrypoint: ${jsonencode(traefik_entrypoint)}
%{ endif ~}
    ports:
      - "80:80"
      - "443:443"
      - "5432:5432"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /mnt/data/certs:/certs
      - /home/${vm_user}/traefik-tls.yml:/etc/traefik/traefik-tls.yml:ro
%{ for volume in traefik_extra_volumes ~}
      - ${volume}
%{ endfor ~}
%{ if length(dns_challenge_env) > 0 || length(traefik_extra_environment) > 0 ~}
    environment:
%{ for key, value in dns_challenge_env ~}
      ${key}: "${value}"
%{ endfor ~}
%{ for key, value in traefik_extra_environment ~}
      ${key}: "${value}"
%{ endfor ~}
%{ endif ~}
    command:
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--providers.docker.network=traefik-net"
      - "--entrypoints.web.address=:80"
      - "--entrypoints.web.http.redirections.entrypoint.to=websecure"
      - "--entrypoints.web.http.redirections.entrypoint.scheme=https"
      - "--entrypoints.websecure.address=:443"
      - "--certificatesresolvers.letsencrypt.acme.dnschallenge=true"
      - "--certificatesresolvers.letsencrypt.acme.dnschallenge.provider=${dns_challenge_provider}"
      - "--certificatesresolvers.letsencrypt.acme.email=${acme_email}"
      - "--certificatesresolvers.letsencrypt.acme.storage=/certs/acme.json"
      - "--entrypoints.postgres.address=:5432"
      - "--providers.file.filename=/etc/traefik/traefik-tls.yml"
%{ if traefik_access_log ~}
      - "--accesslog=true"
      - "--accesslog.format=json"
%{ endif ~}
%{ for arg in traefik_extra_args ~}
      - ${jsonencode(arg)}
%{ endfor ~}
%{ if enable_traefik_metrics || alloy_remote_write_url != "" ~}
      - "--entrypoints.metrics.address=:8080"
      - "--metrics.prometheus=true"
      - "--metrics.prometheus.entrypoint=metrics"
      - "--metrics.prometheus.addRoutersLabels=true"
%{ endif ~}
    restart: unless-stopped
    networks:
      - traefik-net

%{ if use_ecr_credential_helper ~}
  ecr-login:
    image: amazon/aws-cli:2.37.10
    entrypoint: /bin/sh
    environment:
      AWS_DEFAULT_REGION: ${split(".", registry_url)[3]}
    command:
      - -c
      - "while true; do sh /root/.docker/ecr-refresh.sh; sleep 21600; done"
    volumes:
      - /root/.docker:/root/.docker
    healthcheck:
      test: ["CMD", "sh", "-c", "test -f /root/.docker/config.json"]
      interval: 5s
      timeout: 3s
      retries: 12
      start_period: 0s
    restart: unless-stopped

%{ endif ~}
  docker-compose-runner:
    user: root
    image: ${docker_compose_runner_image}
%{ if use_ecr_credential_helper ~}
    depends_on:
      ecr-login:
        condition: service_healthy
%{ endif ~}
    environment:
      OIDC_JWKS_URL: ${oidc_jwks_url}
      OIDC_AUDIENCE: ${oidc_audience}
      OIDC_EXPECTED_SUBS: ${oidc_expected_subs}
      STATIC_PATH: /data/static
      DOCKER_COMPOSE_PATH: /mnt/data/compose
      # Compose derives the project name from the directory holding docker-compose.yml.
      NGINX_STATIC_CONTAINER: ${vm_user}-nginx-static-1
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.runner.rule=Host(`docker.${domain}`)"
      - "traefik.http.routers.runner.tls.certresolver=letsencrypt"
      - "traefik.http.routers.runner.tls.domains[0].main=${domain}"
      - "traefik.http.routers.runner.tls.domains[0].sans=*.${domain}"
      - "traefik.http.routers.runner.middlewares=allowlist-office"
      - "traefik.http.middlewares.allowlist-office.ipallowlist.sourcerange=${ip_allowlist}"
      - "traefik.http.services.runner.loadbalancer.server.port=8080"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
%{ if use_ecr_credential_helper || registry_deferred_login ~}
      - /root/.docker:/root/.docker:ro
%{ else ~}
%{ if registry_url != "" ~}
      - /root/.docker/config.json:/root/.docker/config.json:ro
%{ endif ~}
%{ endif ~}
%{ if length(walg_env_vars) > 0 ~}
      # Stable, user-independent path for app compose files (env_file: /etc/docker-host/walg.env);
      # the /home/<vm_user> one is a symlink kept for compose files written before it existed.
      - /etc/docker-host/walg.env:/etc/docker-host/walg.env:ro
      - /home/${vm_user}/walg.env:/home/${vm_user}/walg.env:ro
%{ endif ~}
      - /mnt/data/compose:/mnt/data/compose
      - /mnt/data/static:/data/static
    restart: unless-stopped
    networks:
      - traefik-net

  ofelia:
    # The maintained netresearch fork, not mcuadros/ofelia 0.3.22: that one reads container labels
    # only once at startup (a project redeployed afterwards silently loses its backup jobs) and keys
    # jobs by name alone, so several projects each defining `backup` collapse to a single job.
    # This one follows Docker events, and job-exec-label-scope=container (ofelia.ini) names jobs
    # <container>.<job>.
    image: ${ofelia_image}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /etc/docker-host/ofelia.ini:/etc/ofelia/config.ini:ro
    command: daemon
    restart: unless-stopped

%{ if alloy_remote_write_url != "" || alloy_loki_write_url != "" ~}
  alloy:
    image: grafana/alloy:v1.20.1
    volumes:
      - /home/${vm_user}/alloy-config.alloy:/etc/alloy/config.alloy:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
    command: run /etc/alloy/config.alloy
    restart: unless-stopped
    networks:
      - traefik-net

%{ endif ~}
%{ if enable_registry ~}
  registry:
    image: registry:2.8.3
    environment:
      REGISTRY_STORAGE_DELETE_ENABLED: "true"
    volumes:
      - /mnt/data/registry:/var/lib/registry
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.registry.rule=Host(`registry.${domain}`)"
      - "traefik.http.routers.registry.tls.certresolver=letsencrypt"
      - "traefik.http.services.registry.loadbalancer.server.port=5000"
%{ if registry_htpasswd != "" ~}
      - "traefik.http.middlewares.registry-auth.basicauth.users=${replace(registry_htpasswd, "$", "$$")}"
      - "traefik.http.routers.registry.middlewares=registry-auth"
%{ endif ~}
      - "ofelia.enabled=true"
      # Garbage collection on a registry that is being pushed to can drop blobs of an in-flight push
      # (docker/distribution recommends read-only mode while it runs); acceptable for the low push
      # rate of a CI registry, revisit if pushes overlap the schedule.
      - "ofelia.job-exec.registry-gc.schedule=@daily"
      - "ofelia.job-exec.registry-gc.command=registry garbage-collect --delete-untagged /etc/docker/registry/config.yml"
    restart: unless-stopped
    networks:
      - traefik-net

%{ endif ~}
  nginx-static:
    image: nginx:1.27-alpine
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.static.rule=HostRegexp(`^[a-z0-9-]+\\.${domain_escaped}$`)"
      - "traefik.http.routers.static.tls=true"
      - "traefik.http.routers.static.priority=1"
      - "traefik.http.services.static.loadbalancer.server.port=80"
%{ for label in static_extra_labels ~}
      - ${jsonencode(label)}
%{ endfor ~}
    volumes:
      - /home/${vm_user}/nginx-static.conf:/etc/nginx/conf.d/default.conf:ro
      - /mnt/data/static:/data/static:ro
    restart: unless-stopped
    networks:
      - traefik-net
%{ if extra_compose_services != "" ~}

  ${indent(2, extra_compose_services)}
%{ endif ~}
